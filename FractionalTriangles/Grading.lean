import Mathlib

namespace FractionalTriangles

/-
A concrete model of the Geigle--Lenzing grading group

  L = <x,y,z,c | p x = c, q y = c, r z = c>.

We realize it as the quotient of Z^4 by the subgroup generated by
(p,0,0,-1), (0,q,0,-1), (0,0,r,-1).
-/

abbrev Ambient := Fin 4 → ℤ

def relX (p : ℕ) : Ambient := ![(p : ℤ), 0, 0, -1]
def relY (q : ℕ) : Ambient := ![0, (q : ℤ), 0, -1]
def relZ (r : ℕ) : Ambient := ![0, 0, (r : ℤ), -1]

def Relations (p q r : ℕ) : AddSubgroup Ambient :=
  AddSubgroup.closure {relX p, relY q, relZ r}

abbrev GradingGroup (p q r : ℕ) :=
  Ambient ⧸ Relations p q r

def xbar (p q r : ℕ) : GradingGroup p q r :=
  QuotientAddGroup.mk' (Relations p q r) ![1,0,0,0]

def ybar (p q r : ℕ) : GradingGroup p q r :=
  QuotientAddGroup.mk' (Relations p q r) ![0,1,0,0]

def zbar (p q r : ℕ) : GradingGroup p q r :=
  QuotientAddGroup.mk' (Relations p q r) ![0,0,1,0]

def cbar (p q r : ℕ) : GradingGroup p q r :=
  QuotientAddGroup.mk' (Relations p q r) ![0,0,0,1]

/-- The three defining relations hold in the quotient. -/
theorem p_x_eq_c (p q r : ℕ) :
    p • xbar p q r = cbar p q r := by
  apply QuotientAddGroup.eq_iff_sub_mem.mpr
  change ((p : ℤ) • ![1,0,0,0] - ![0,0,0,1]) ∈ Relations p q r
  have h : relX p ∈ Relations p q r :=
    AddSubgroup.subset_closure (by simp [relX])
  simpa [relX] using h

theorem q_y_eq_c (p q r : ℕ) :
    q • ybar p q r = cbar p q r := by
  apply QuotientAddGroup.eq_iff_sub_mem.mpr
  change ((q : ℤ) • ![0,1,0,0] - ![0,0,0,1]) ∈ Relations p q r
  have h : relY q ∈ Relations p q r :=
    AddSubgroup.subset_closure (by simp [relY])
  simpa [relY] using h

theorem r_z_eq_c (p q r : ℕ) :
    r • zbar p q r = cbar p q r := by
  apply QuotientAddGroup.eq_iff_sub_mem.mpr
  change ((r : ℤ) • ![0,0,1,0] - ![0,0,0,1]) ∈ Relations p q r
  have h : relZ r ∈ Relations p q r :=
    AddSubgroup.subset_closure (by simp [relZ])
  simpa [relZ] using h

/-- The dualizing element ω = c-x-y-z in the concrete grading group. -/
def omega (p q r : ℕ) : GradingGroup p q r :=
  cbar p q r - xbar p q r - ybar p q r - zbar p q r

end FractionalTriangles
