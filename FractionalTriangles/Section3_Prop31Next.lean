/-!
# Section 3 — Proposition 3.1, next verification block

Paper pp. 6–7, Proposition 3.1.

This block strengthens the previous audit by proving the finite-abelian-group
cardinality mechanism behind (3.4) abstractly, rather than assuming the final
cardinality formula.  It also isolates the exact character-annihilator logic
used for (3.3).

No `sorry`, no axioms.
-/

section QuotientCardinality

variable {A : Type*} [AddCommGroup A] [Fintype A]

/--
For a finite abelian group A and an element τ, quotienting by the cyclic
subgroup generated by τ has cardinality |A| / |<τ>|.
This is the abstract finite-group cardinality step used in (3.4).
-/
theorem card_quotient_zmultiples
    (τ : A) :
    Fintype.card (A ⧸ AddSubgroup.zmultiples τ) *
        Fintype.card (AddSubgroup.zmultiples τ) =
      Fintype.card A := by
  simpa [mul_comm] using
    (QuotientAddGroup.card_eq_card_quotient_mul_card_subgroup
      (AddSubgroup.zmultiples τ))

end QuotientCardinality

section CharacterAnnihilator

variable {G : Type*} [CommGroup G]

/--
Exact coprime-exponent logic in the converse of (3.3).
This is deliberately independent of complex numbers: it holds in every group.
-/
theorem prop31_character_converse
    (a : G) (δ N : ℕ)
    (hδ : a ^ δ = 1)
    (hN : a ^ N = 1)
    (hcop : Nat.Coprime δ N) :
    a = 1 :=
  group_element_eq_one_of_coprime_powers a δ N hcop hδ hN

/--
The forward relation alpha(omega)=1 from omega=δ tau and alpha(tau)=1,
written as the multiplicative character calculation.
-/
theorem prop31_character_forward
    (a : G) (δ : ℕ) (ha : a = 1) :
    a ^ δ = 1 := by
  simpa [ha]

/--
The product relation used in (3.3): if every p_i-th power is rho and
rho is the product, then the displayed equations are simultaneously recorded.
This theorem is intentionally only bookkeeping; the substantive derivation
from the grading relations is handled by the grading-character layer.
-/
theorem prop31_displayed_relations_n3
    (α1 α2 α3 ρ : G) (p q r : ℕ)
    (hp : α1^p = ρ) (hq : α2^q = ρ) (hr : α3^r = ρ)
    (hprod : ρ = α1*α2*α3) :
    α1^p = ρ ∧ α2^q = ρ ∧ α3^r = ρ ∧ ρ = α1*α2*α3 :=
  ⟨hp,hq,hr,hprod⟩

end CharacterAnnihilator

section OrderArithmetic

/--
The exact last arithmetic line of the proof of (3.4):
u * (Π p_i / N) = μ Π p_i from u=Nμ.
-/
theorem prop31_order_last_line
    (u μ p q r N : ℚ)
    (hN : N ≠ 0)
    (hu : u = N*μ) :
    u * ((p*q*r)/N) = μ*p*q*r := by
  rw [hu]
  field_simp [hN]
  ring

end OrderArithmetic

end FractionalTriangles
