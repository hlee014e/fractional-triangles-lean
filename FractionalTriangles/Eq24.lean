import Mathlib
import FractionalTriangles.Grading
import FractionalTriangles.Section2_FinalArithmetic

namespace FractionalTriangles

/-!
# Equation (2.4)

Paper: Section 2, immediately before Lemma 2.1.

This file formalizes the quotient statement
  L / Z c ≃ ZMod p × ZMod q × ZMod r
for the three-variable grading group.

The clean way to see it is to quotient the ambient Z^4 first by the subgroup
generated by c and by the three defining relations.  The resulting relations
are exactly p x = 0, q y = 0, r z = 0.

No `sorry` and no axioms.
-/

abbrev ResidueTriple (p q r : ℕ) := ZMod p × ZMod q × ZMod r

/-- Residue map on the ambient lattice: forget c and reduce x,y,z. -/
def ambientResidue (p q r : ℕ) : Ambient →+ ResidueTriple p q r where
  toFun := fun a => (a 0, a 1, a 2)
  map_zero' := by simp
  map_add' := by
    intro a b
    simp

/-- The defining relation subgroup of L is killed by the residue map. -/
theorem relations_le_ker_ambientResidue (p q r : ℕ) :
    relations p q r ≤ (ambientResidue p q r).ker := by
  intro v hv
  rcases hv with ⟨a, b, c, rfl⟩
  simp [ambientResidue, relP, relQ, relR]

/-- Hence the residue map descends to L. -/
def residueMap (p q r : ℕ) :
    GradingGroup p q r →+ ResidueTriple p q r :=
  QuotientAddGroup.lift (relations p q r) (ambientResidue p q r)
    (relations_le_ker_ambientResidue p q r)

/-- c maps to zero. -/
@[simp] theorem residueMap_c (p q r : ℕ) :
    residueMap p q r (cbar p q r) = 0 := by
  rfl

@[simp] theorem residueMap_x (p q r : ℕ) :
    residueMap p q r (xbar p q r) = (1,0,0) := by
  rfl

@[simp] theorem residueMap_y (p q r : ℕ) :
    residueMap p q r (ybar p q r) = (0,1,0) := by
  rfl

@[simp] theorem residueMap_z (p q r : ℕ) :
    residueMap p q r (zbar p q r) = (0,0,1) := by
  rfl

/-- The residue map is surjective. -/
theorem residueMap_surjective (p q r : ℕ) :
    Function.Surjective (residueMap p q r) := by
  intro t
  rcases t with ⟨⟨a,b⟩,c⟩
  refine ⟨(a.val : ℤ) • xbar p q r +
           (b.val : ℤ) • ybar p q r +
           (c.val : ℤ) • zbar p q r, ?_⟩
  simp

/--
Kernel statement equivalent to (2.4): an element has zero residues exactly
when it is an integral multiple of c.
-/
theorem mem_ker_residueMap_iff (p q r : ℕ) (v : GradingGroup p q r) :
    residueMap p q r v = 0 ↔ ∃ n : ℤ, v = n • cbar p q r := by
  refine QuotientAddGroup.induction_on v ?_
  intro a
  constructor
  · intro h
    have hx : (a 0 : ZMod p) = 0 := by
      simpa [residueMap, ambientResidue] using congrArg Prod.fst (congrArg Prod.fst h)
    have hy : (a 1 : ZMod q) = 0 := by
      simpa [residueMap, ambientResidue] using congrArg Prod.snd (congrArg Prod.fst h)
    have hz : (a 2 : ZMod r) = 0 := by
      simpa [residueMap, ambientResidue] using congrArg Prod.snd h
    have hp : (p : ℤ) ∣ a 0 := by simpa using hx
    have hq : (q : ℤ) ∣ a 1 := by simpa using hy
    have hr : (r : ℤ) ∣ a 2 := by simpa using hz
    rcases hp with ⟨ap, hap⟩
    rcases hq with ⟨aq, haq⟩
    rcases hr with ⟨ar, har⟩
    refine ⟨a 3 + ap + aq + ar, ?_⟩
    apply QuotientAddGroup.eq_iff_sub_mem.mpr
    refine ⟨-ap, -aq, -ar, ?_⟩
    funext i
    fin_cases i <;> simp [relP, relQ, relR, hap, haq, har]
    <;> ring
  · rintro ⟨n, rfl⟩
    simp

/--
Equation (2.4) in First-Isomorphism-Theorem form:
L / ker(residueMap) is isomorphic to the residue triple.
Together with `mem_ker_residueMap_iff`, the kernel is precisely Z c.
-/
noncomputable def eq24_iso (p q r : ℕ) :
    (GradingGroup p q r ⧸ (residueMap p q r).ker) ≃+ ResidueTriple p q r :=
  QuotientAddGroup.quotientKerEquivOfSurjective
    (residueMap p q r) (residueMap_surjective p q r)

/-- The paper's second statement in (2.4): omega has residues (-1,-1,-1). -/
theorem omega_mod_c (p q r : ℕ) :
    residueMap p q r (omega p q r) = (-1,-1,-1) := by
  simp [omega]

end FractionalTriangles
